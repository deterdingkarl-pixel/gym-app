# Supabase-Zugangsdaten (Project Settings → API).
# Kopieren nach .env und ausfüllen. NIEMALS den service_role-Schlüssel eintragen.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-public-key

# Nur auf dem Server (Vercel → Environment Variables), OHNE VITE_-Vorsatz, damit sie nie in der App landen.
# GARMIN_API_KEY=persönlicher Schlüssel aus Garmin Connect (wie ein Passwort behandeln)
# GARMIN_ALLOWED_EMAIL=E-Mail des einzigen Kontos, das die Garmin-Daten abrufen darf
